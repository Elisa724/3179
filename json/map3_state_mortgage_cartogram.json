{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 540,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "projection": {
    "type": "equirectangular",
    "center": [134.0, -28.2],
    "scale": 760
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states.topojson"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#faf8f2",
        "stroke": "#bcb382",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/map3_state_mortgage_cartogram.csv",
        "format": {
          "type": "csv",
          "parse": {"Year": "number", "Lending_Value_M": "number"}
        }
      },
      "transform": [
        {
          "lookup": "State",
          "from": {
            "data": {
              "values": [
                {"State": "WA",  "lon": 121.5, "lat": -27.5},
                {"State": "NT",  "lon": 133.5, "lat": -20.5},
                {"State": "SA",  "lon": 135.0, "lat": -31.5},
                {"State": "QLD", "lon": 144.5, "lat": -23.5},
                {"State": "NSW", "lon": 147.5, "lat": -32.5},
                {"State": "VIC", "lon": 143.5, "lat": -37.0},
                {"State": "ACT", "lon": 149.8, "lat": -36.2},
                {"State": "TAS", "lon": 146.6, "lat": -42.2}
              ]
            },
            "key": "State",
            "fields": ["lon", "lat"]
          }
        },
        {"calculate": "datum.Year == 2021 ? 0 : (datum.Year == 2023 ? 1 : 2)", "as": "yi"},
        {"calculate": "datum.lon + (datum.yi - 1) * 1.70 - 0.70", "as": "x0"},
        {"calculate": "datum.x0 + 1.40", "as": "x1"},
        {
          "calculate": "datum.lat + max(0.55, datum.Lending_Value_M * 0.00080)",
          "as": "y1"
        },
        {"calculate": "(datum.x0 + datum.x1) / 2", "as": "xm"},
        {
          "calculate": "format(datum.Lending_Value_M / 1000, '.1f')",
          "as": "label"
        },
        {
          "calculate": "datum.Lending_Value_M / 1000",
          "as": "Commitment_B"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "#ffffff",
            "strokeWidth": 1.0,
            "cornerRadiusEnd": 2,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {"field": "x0", "type": "quantitative"},
            "longitude2": {"field": "x1"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "latitude2": {"field": "y1"},
            "color": {
              "field": "Year",
              "type": "ordinal",
              "scale": {
                "domain": [2021, 2023, 2026],
                "range": ["#68b98b", "#09814a", "#1b382b"]
              },
              "title": "Milestone Year ($B)",
              "legend": {
                "orient": "bottom-left",
                "direction": "horizontal",
                "symbolType": "square",
                "symbolSize": 160,
                "titleFontSize": 12,
                "titleFontWeight": "bold",
                "titleColor": "#1b382b",
                "labelFontSize": 11.5,
                "labelFontWeight": "600",
                "labelColor": "#181d20",
                "offset": 10
              }
            },
            "tooltip": [
              {"field": "State", "type": "nominal", "title": "State / Territory"},
              {"field": "Year", "type": "ordinal", "title": "Milestone Year"},
              {
                "field": "Commitment_B",
                "type": "quantitative",
                "title": "Total Commitments ($B)",
                "format": "$,.2f"
              },
              {
                "field": "Lending_Value_M",
                "type": "quantitative",
                "title": "Exact Amount ($M)",
                "format": "$,.1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10.5,
            "fontWeight": "bold",
            "dy": -7,
            "fill": "#181d20"
          },
          "encoding": {
            "longitude": {"field": "xm", "type": "quantitative"},
            "latitude": {"field": "y1", "type": "quantitative"},
            "text": {"field": "label", "type": "nominal"}
          }
        },
        {
          "transform": [{"filter": "datum.Year == 2023"}],
          "mark": {
            "type": "text",
            "fontSize": 12.5,
            "fontWeight": "bold",
            "dy": 16,
            "fill": "#1b382b"
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "State", "type": "nominal"}
          }
        }
      ]
    }
  ],
  "config": {"view": {"stroke": null}}
}