{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/cpi_bump_ranks.csv"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "title": "Year (June Quarter Snapshot)",
        "labelAngle": 0,
        "labelFontSize": 10.5,
        "titleFontSize": 11,
        "titleFontWeight": "bold",
        "titlePadding": 8,
        "grid": true,
        "gridDash": [
          2,
          2
        ],
        "gridColor": "#e2e8f0"
      }
    },
    "y": {
      "field": "Rank",
      "type": "ordinal",
      "sort": "ascending",
      "axis": {
        "title": "Rank",
        "labelExpr": "'#' + datum.value",
        "labelFontSize": 10,
        "titleFontSize": 11,
        "titleFontWeight": "bold",
        "titlePadding": 6
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "strokeWidth": {
          "condition": {
            "param": "highlightCategory",
            "empty": false,
            "value": 4
          },
          "value": 2
        },
        "opacity": {
          "condition": {
            "param": "highlightCategory",
            "empty": false,
            "value": 1.0
          },
          "value": 0.4
        },
        "color": {
          "field": "Display Name",
          "type": "nominal",
          "legend": {
            "title": "Category",
            "orient": "bottom",
            "columns": 3,
            "titleFontSize": 10,
            "titleFontWeight": "bold",
            "labelFontSize": 9.5,
            "labelLimit": 220,
            "symbolType": "stroke",
            "symbolStrokeWidth": 2.5
          },
          "scale": {
            "scheme": "category20"
          }
        }
      },
      "params": [
        {
          "name": "highlightCategory",
          "select": {
            "type": "point",
            "fields": [
              "Display Name"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "circle",
        "size": 75,
        "fill": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "stroke": {
          "field": "Display Name",
          "type": "nominal",
          "legend": null,
          "scale": {
            "scheme": "category20"
          }
        },
        "opacity": {
          "condition": {
            "param": "highlightCategory",
            "empty": false,
            "value": 1.0
          },
          "value": 0.85
        },
        "tooltip": [
          {
            "field": "Display Name",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Period"
          },
          {
            "field": "Rank",
            "type": "ordinal",
            "title": "Rank"
          },
          {
            "field": "Inflation_Rate",
            "type": "quantitative",
            "title": "Rate (%)"
          }
        ]
      }
    }
  ]
}