        "dx": -20,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "lineHeight": 14,
        "fill": "#0369a1"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "Rank", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
