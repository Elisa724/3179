        "strokeWidth": 4,
        "strokeJoin": "round",
        "fill": "#ffffff"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "Rank", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": "2026",
            "Rank": 11,
            "label": [
              "Transport drops to #11 (-0.7%) →",
              "Fuel & shipping deflation"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -20,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "lineHeight": 14,
        "fill": "#334155"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "Rank", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}