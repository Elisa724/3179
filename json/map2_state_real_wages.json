{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "data": {
    "url": "data/australia_states.json",
    "format": {
      "type": "topojson",
      "feature": "australia_states.topojson"
    }
  },
  "spacing": 20,
  "bounds": "flush",
  "hconcat": [
    {
      "title": {
        "text": "1. Onset (June 2021)",
        "fontSize": 14,
        "font": "Georgia, serif",
        "color": "#1b382b",
        "anchor": "middle",
        "subtitle": [
          "NT (-4.3%) and QLD (-3.4%) see",
          "early purchasing power loss."
        ],
        "subtitleColor": "#8c3014",
        "subtitleFontSize": 11.5,
        "subtitleFont": "Inter, sans-serif",
        "subtitlePadding": 4
      },
      "width": 406,
      "height": 340,
      "projection": {
        "type": "equirectangular",
        "center": [
          133.4,
          -27.2
        ],
        "scale": 540,
        "translate": [
          203,
          170
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "geoshape",
            "fill": "#ece8de",
            "stroke": "#ffffff",
            "strokeWidth": 1.1
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.properties.name",
              "as": "State_Key"
            },
            {
              "lookup": "State_Key",
              "from": {
                "data": {
                  "values": [
                    {
                      "State_Name": "New South Wales",
                      "Gap": -2.6,
                      "WPI": 1.5,
                      "CPI": 4.1
                    },
                    {
                      "State_Name": "Victoria",
                      "Gap": -1.5,
                      "WPI": 1.5,
                      "CPI": 3.0
                    },
                    {
                      "State_Name": "Queensland",
                      "Gap": -3.4,
                      "WPI": 1.6,
                      "CPI": 5.0
                    },
                    {
                      "State_Name": "South Australia",
                      "Gap": -1.2,
                      "WPI": 1.6,
                      "CPI": 2.8
                    },
                    {
                      "State_Name": "Western Australia",
                      "Gap": -2.8,
                      "WPI": 1.4,
                      "CPI": 4.2
                    },
                    {
                      "State_Name": "Tasmania",
                      "Gap": -1.8,
                      "WPI": 1.9,
                      "CPI": 3.7
                    },
                    {
                      "State_Name": "Northern Territory",
                      "Gap": -4.3,
                      "WPI": 1.8,
                      "CPI": 6.1
                    },
                    {
                      "State_Name": "Australian Capital Territory",
                      "Gap": -3.4,
                      "WPI": 1.4,
                      "CPI": 4.8
                    }
                  ]
                },
                "key": "State_Name",
                "fields": [
                  "State_Name",
                  "Gap",
                  "WPI",
                  "CPI"
                ]
              }
            },
            {
              "filter": "isValid(datum.Gap)"
            },
            {
              "calculate": "'June 2021'",
              "as": "Year"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 1.1,
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "field": "Gap",
              "type": "quantitative",
              "title": "Real Wage Gap (%)",
              "scale": {
                "type": "linear",
                "domain": [
                  -4.5,
                  -2.5,
                  0
                ],
                "range": [
                  "#7f2704",
                  "#d94801",
                  "#fee6ce"
                ],
                "clamp": true
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 280,
                "gradientThickness": 12,
                "titleFont": "Inter, sans-serif",
                "titleFontSize": 11.5,
                "titleFontWeight": 700,
                "titleColor": "#1b382b",
                "labelFont": "Inter, sans-serif",
                "labelFontSize": 10.5,
                "labelColor": "#5e6b64",
                "values": [
                  -4,
                  -3,
                  -2,
                  -1,
                  0
                ],
                "labelExpr": "datum.label + '%'",
                "offset": 12
              }
            },
            "tooltip": [
              {
                "field": "State_Name",
                "type": "nominal",
                "title": "State / Territory"
              },
              {
                "field": "Year",
                "type": "nominal",
                "title": "Period"
              },
              {
                "field": "WPI",
                "type": "quantitative",
                "title": "Wage Growth, WPI (%)",
                "format": ".1f"
              },
              {
                "field": "CPI",
                "type": "quantitative",
                "title": "Headline CPI (%)",
                "format": ".1f"
              },
              {
                "field": "Gap",
                "type": "quantitative",
                "title": "Real Wage Gap (%)",
                "format": ".1f"
              }
            ]
          }
        }
