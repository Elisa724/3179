{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Non-Negotiable Squeeze: Essential vs. Discretionary CPI",
    "subtitle": "Annual price growth by consumer expenditure category (ABS Cat 6401.0, Table 2)",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start",
    "color": "#121619"
  },
  "width": "container",
  "height": 340,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "data": {
    "url": "data/cpi_essential_discretionary.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4,
    "height": {"band": 0.75}
  },
  "encoding": {
    "y": {
      "field": "Categories",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelFontSize": 11,
        "labelColor": "#121619",
        "labelLimit": 300
      }
    },
    "x": {
      "field": "Inflation_Rate_Pct",
      "type": "quantitative",
      "title": "Annual Inflation Rate (%)",
      "axis": {
        "grid": true,
        "gridColor": "#e5e7eb",
        "titleFontSize": 11,
        "labelFontSize": 10
      }
    },
    "color": {
      "field": "Classification",
      "type": "nominal",
      "title": "Expenditure Type",
      "scale": {
        "domain": ["Essential", "Discretionary"],
        "range": ["#2D4739", "#E5C687"]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleFontSize": 11,
        "labelFontSize": 10
      }
    },
    "tooltip": [
      {"field": "Categories", "type": "nominal", "title": "CPI Group"},
      {"field": "Classification", "type": "nominal", "title": "Category Type"},
      {
        "field": "Inflation_Rate_Pct",
        "type": "quantitative",
        "title": "Annual Inflation Rate (%)",
        "format": ".1f"
      }
    ]
  }
}