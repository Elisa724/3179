{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 520,
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] ? containerSize()[0] : 520",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] ? containerSize()[0] : 520"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": "data/cpi_basket_weights.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Weight_Pct": "number",
          "Inflation_Rate_Pct": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Categories === 'Food and non-alcoholic beverages' ? 'Food & Non-Alc.' : datum.Categories === 'Recreation and culture' ? 'Recreation' : datum.Categories === 'Furnishings household equipment and services' || datum.Categories === 'Furnishings, household equipment and services' ? 'Furnishings' : datum.Categories === 'Insurance and financial services' ? 'Insurance & Finance' : datum.Categories === 'Alcohol and tobacco' ? 'Alcohol & Tobacco' : datum.Categories === 'Clothing and footwear' ? 'Clothing & Footwear' : datum.Categories === 'Communication' ? 'Communication' : datum.Categories",
          "as": "Clean_Name"
        }
      ]
    },
    {
      "name": "root_node",
      "values": [
        {
          "id": "Total_Basket",
          "parent": null,
          "name": "Total Consumer Basket"
        }
      ]
    },
    {
      "name": "group_nodes",
      "values": [
        {
          "id": "Essential",
          "parent": "Total_Basket",
          "name": "Essential Needs",
          "Classification": "Essential"
        },
        {
          "id": "Discretionary",
          "parent": "Total_Basket",
          "name": "Discretionary",
          "Classification": "Discretionary"
        }
      ]
    },
    {
      "name": "leaf_nodes",
      "source": "raw",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Categories",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "datum.Classification",
          "as": "parent"
        },
        {
          "type": "formula",
          "expr": "datum.Weight_Pct",
          "as": "value"
        }
      ]
    },
    {
      "name": "tree",
      "source": ["root_node", "group_nodes", "leaf_nodes"],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.35,
          "paddingInner": 3,
          "paddingOuter": 5,
          "paddingTop": 25,
          "size": [
            {"signal": "width"},
            {"signal": "height - 46"}
          ]
        }
      ]
    },
    {
      "name": "containers",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "colorScale",
      "type": "ordinal",
      "domain": ["Essential", "Discretionary"],
      "range": ["#274736", "#dfba73"]
    }
  ],
  "legends": [
    {
      "fill": "colorScale",
      "title": "Expenditure Type",
      "orient": "bottom",
      "direction": "horizontal",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1b382b",
      "labelFontSize": 11.5,
      "labelColor": "#5e6b64",
      "symbolType": "square",
      "symbolSize": 140,
      "offset": 6
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "containers"},
      "interactive": false,
      "encode": {
        "enter": {
          "fill": {"value": "#faf8f2"},
          "stroke": {"value": "#bcb382"},
          "strokeWidth": {"value": 1.5},
          "cornerRadius": {"value": 4}
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "containers"},
      "interactive": false,
      "encode": {
        "enter": {
          "cornerRadiusTopLeft": {"value": 4},
          "cornerRadiusTopRight": {"value": 4}
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"signal": "datum.y0 + 23"},
          "fill": {
            "signal": "datum.id === 'Essential' ? '#1b382b' : '#9a6f1a'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "containers"},
      "interactive": false,
      "encode": {
        "enter": {
          "font": {"value": "Inter, sans-serif"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fill": {"value": "#ffffff"}
        },
        "update": {
          "x": {"signal": "0.5 * (datum.x0 + datum.x1)"},
          "y": {"signal": "datum.y0 + 11.5"},
          "text": {"field": "name"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 2},
          "cornerRadius": {"value": 2},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {
            "scale": "colorScale",
            "field": "Classification"
          },
          "fillOpacity": {"value": 0.95},
          "tooltip": {
            "signal": "{\"Spending Category\": datum.Categories, \"Classification\": datum.Classification === 'Essential' ? 'Essential (Non-Negotiable)' : 'Discretionary (Optional)', \"Household Basket Share\": format(datum.Weight_Pct, '.1f') + '%'}"
          }
        },
        "hover": {
          "fill": {"value": "#e0882e"},
          "fillOpacity": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "enter": {
          "font": {"value": "Inter, sans-serif"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontWeight": {"value": "bold"}
        },
        "update": {
          "x": {"signal": "0.5 * (datum.x0 + datum.x1)"},
          "y": {
            "signal": "(datum.y1 - datum.y0 < 42) ? 0.5 * (datum.y0 + datum.y1) : 0.5 * (datum.y0 + datum.y1) - 8"
          },
          "text": {"field": "Clean_Name"},
          "fontSize": {
            "signal": "(datum.x1 - datum.x0 < 65 || datum.y1 - datum.y0 < 36) ? 8.5 : 11"
          },
          "limit": {"signal": "max(8, datum.x1 - datum.x0 - 6)"},
          "fill": {
            "signal": "datum.Classification === 'Essential' ? '#ffffff' : '#181d20'"
          },
          "opacity": {
            "signal": "(datum.x1 - datum.x0 < 35 || datum.y1 - datum.y0 < 20) ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "enter": {
          "font": {"value": "Inter, sans-serif"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontWeight": {"value": "600"}
        },
        "update": {
          "x": {"signal": "0.5 * (datum.x0 + datum.x1)"},
          "y": {"signal": "0.5 * (datum.y0 + datum.y1) + 8"},
          "text": {
            "signal": "datum.Categories === 'Housing' ? format(datum.Weight_Pct, '.1f') + '% (Largest Share)' : format(datum.Weight_Pct, '.1f') + '%'"
          },
          "fontSize": {
            "signal": "(datum.x1 - datum.x0 < 65 || datum.y1 - datum.y0 < 44) ? 8 : 10"
          },
          "limit": {"signal": "max(8, datum.x1 - datum.x0 - 6)"},
          "fill": {
            "signal": "datum.Classification === 'Essential' ? '#e2ebd8' : '#3d301b'"
          },
          "opacity": {
            "signal": "(datum.x1 - datum.x0 < 55 || datum.y1 - datum.y0 < 38) ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "rect",
      "interactive": false,
      "encode": {
        "enter": {
          "cornerRadius": {"value": 5},
          "fill": {"value": "#f7f4ed"},
          "stroke": {"value": "#bcb382"},
          "strokeWidth": {"value": 1.2}
        },
        "update": {
          "x": {"value": 0},
          "y": {"signal": "height - 35"},
          "width": {"signal": "width"},
          "height": {"value": 28}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "enter": {
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#1b382b"}
        },
        "update": {
          "x": {"signal": "0.5 * width"},
          "y": {"signal": "height - 21"},
          "text": {
            "value": "★ Core Insight: Housing (21.4%), Food (17.4%) & Transport (11.5%) command 50.3% of spending"
          }
        }
      }
    }
  ],
  "padding": {
    "top": 4,
    "left": 4,
    "right": 4,
    "bottom": 4
  }
}