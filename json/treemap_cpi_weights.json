{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 520,
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] ? containerSize()[0] : 520",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] ? containerSize()[0] : 520"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": "data/cpi_basket_weights.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Weight_Pct": "number",
          "Inflation_Rate_Pct": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.Categories === 'Food and non-alcoholic beverages' ? 'Food & Non-Alc.' : datum.Categories === 'Recreation and culture' ? 'Recreation' : datum.Categories === 'Furnishings, household equipment and services' ? 'Furnishings' : datum.Categories === 'Insurance and financial services' ? 'Insurance' : datum.Categories === 'Alcohol and tobacco' ? 'Alcohol & Tob.' : datum.Categories === 'Clothing and footwear' ? 'Clothing' : datum.Categories === 'Communication' ? 'Comm.' : datum.Categories",
          "as": "Clean_Name"
        }
      ]
    },
    {
      "name": "root_node",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "Weight_Pct"
          ],
          "as": [
            "Weight_Pct"
          ]
        },
        {
          "type": "formula",
          "expr": "'Total Basket'",
          "as": "Categories"
        },
        {
          "type": "formula",
          "expr": "null",
          "as": "parent"
        },
        {
          "type": "formula",
          "expr": "0",
          "as": "Weight_Pct"
        }
      ]
    },
    {
      "name": "child_nodes",
      "source": "raw",
      "transform": [
        {
          "type": "formula",
          "expr": "'Total Basket'",
          "as": "parent"
        }
      ]
    },
    {
      "name": "tree",
      "source": [
        "root_node",
        "child_nodes"
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "Categories",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "Weight_Pct",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.45,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        },
        {
          "type": "filter",
          "expr": "datum.depth > 0"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "colorScale",
      "type": "ordinal",
      "domain": [
        "Essential",
        "Discretionary"
      ],
      "range": [
        "#2D4739",
        "#E5C687"
      ]
    }
  ],
  "legends": [
    {
      "fill": "colorScale",
      "title": "Expenditure Type",
      "orient": "bottom",
      "direction": "horizontal",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelFontSize": 11.5,
      "labelFontWeight": "500",
      "symbolType": "square",
      "symbolSize": 100
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "colorScale",
            "field": "Classification"
          },
          "tooltip": {
            "signal": "{\"Category\": datum.Categories, \"Classification\": datum.Classification, \"Basket Weight\": datum.Weight_Pct + '%', \"Annual Inflation (Jun 2026)\": datum.Inflation_Rate_Pct + '%'}"
          }
        },
        "hover": {
          "fill": {
            "value": "#b87c28"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontWeight": {
            "value": "bold"
          }
        },
        "update": {
          "x": {
            "signal": "0.5 * (datum.x0 + datum.x1)"
          },
          "y": {
            "signal": "0.5 * (datum.y0 + datum.y1) - 6"
          },
          "text": {
            "signal": "datum.Clean_Name"
          },
          "fontSize": {
            "signal": "(datum.x1 - datum.x0 < 60 || datum.y1 - datum.y0 < 35) ? 8 : 10.5"
          },
          "limit": {
            "signal": "max(8, datum.x1 - datum.x0 - 2)"
          },
          "fill": {
            "signal": "datum.Classification === 'Essential' ? '#ffffff' : '#121619'"
          },
          "opacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          }
        },
        "update": {
          "x": {
            "signal": "0.5 * (datum.x0 + datum.x1)"
          },
          "y": {
            "signal": "0.5 * (datum.y0 + datum.y1) + 7"
          },
          "text": {
            "signal": "datum.Weight_Pct + '%'"
          },
          "fontSize": {
            "signal": "(datum.x1 - datum.x0 < 60 || datum.y1 - datum.y0 < 35) ? 7.5 : 9.5"
          },
          "limit": {
            "signal": "max(8, datum.x1 - datum.x0 - 2)"
          },
          "fill": {
            "signal": "datum.Classification === 'Essential' ? '#e2e8f0' : '#2b2b2b'"
          },
          "opacity": {
            "value": 1
          }
        }
      }
    }
  ],
  "padding": {
    "top": 4,
    "left": 4,
    "right": 4,
    "bottom": 4
  }
}