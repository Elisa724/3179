{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Capital City Inflation Pressures Across Australia",
    "subtitle": "Circle size encodes annual CPI percentage change (ABS Cat 6401.0)",
    "fontSize": 15,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "#5e6b64",
    "anchor": "start",
    "color": "#1b382b"
  },
  "width": "container",
  "height": 490,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "params": [
    {
      "name": "selected_date",
      "value": "2026-07",
      "bind": {
        "input": "select",
        "options": ["2026-07", "2025-07"],
        "labels": ["July 2026 (Latest Snapshot)", "July 2025 (Previous Year)"],
        "name": "Select CPI Milestone: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [134.0, -28.2],
    "scale": 615
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states.topojson"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#faf8f2",
        "stroke": "#bcb382",
        "strokeWidth": 1.1
      }
    },
    {
      "data": {
        "url": "data/cpi_australia_capital_city.csv"
      },
      "transform": [
        {"filter": "datum.Date == selected_date"},
        {
          "calculate": "datum.City == 'Horbart' ? 'Hobart' : datum.City",
          "as": "Clean_City"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#09814a",
        "fillOpacity": 0.45,
        "stroke": "#1b382b",
        "strokeWidth": 2.0,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "size": {
          "field": "CPI_Annual_Change_Pct",
          "type": "quantitative",
          "title": "Annual Inflation Rate (%)",
          "scale": {
            "domain": [2.0, 5.0],
            "range": [500, 2500]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 11,
            "titleFontWeight": "bold",
            "titleColor": "#1b382b",
            "labelFontSize": 10.5,
            "labelColor": "#5e6b64",
            "columnPadding": 16,
            "offset": 14
          }
        },
        "tooltip": [
          {"field": "Clean_City", "type": "nominal", "title": "Capital City"},
          {"field": "State", "type": "nominal", "title": "State / Territory"},
          {"field": "Date", "type": "nominal", "title": "Reference Period"},
          {"field": "CPI_Annual_Change_Pct", "type": "quantitative", "title": "Annual Inflation Rate (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "url": "data/cpi_australia_capital_city.csv"
      },
      "transform": [
        {"filter": "datum.Date == selected_date"},
        {
          "calculate": "datum.City == 'Horbart' ? 'Hobart' : datum.City",
          "as": "Clean_City"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "fill": "#ffffff",
        "stroke": "#ffffff",
        "strokeWidth": 4,
        "strokeJoin": "round",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "text": {"field": "Clean_City", "type": "nominal"},
        "align": {
          "condition": [
            {"test": "datum.City == 'Canberra'", "value": "right"},
            {"test": "datum.City == 'Sydney'", "value": "left"},
            {"test": "datum.City == 'Melbourne'", "value": "center"},
            {"test": "datum.City == 'Hobart' || datum.City == 'Horbart'", "value": "left"},
            {"test": "datum.City == 'Perth'", "value": "right"},
            {"test": "datum.City == 'Brisbane'", "value": "left"},
            {"test": "datum.City == 'Adelaide'", "value": "right"},
            {"test": "datum.City == 'Darwin'", "value": "center"}
          ],
          "value": "center"
        },
        "dx": {
          "condition": [
            {"test": "datum.City == 'Canberra'", "value": -26},
            {"test": "datum.City == 'Sydney'", "value": 26},
            {"test": "datum.City == 'Hobart' || datum.City == 'Horbart'", "value": 26},
            {"test": "datum.City == 'Perth'", "value": -26},
            {"test": "datum.City == 'Brisbane'", "value": 26},
            {"test": "datum.City == 'Adelaide'", "value": -26}
          ],
          "value": 0
        },
        "dy": {
          "condition": [
            {"test": "datum.City == 'Darwin'", "value": -24},
            {"test": "datum.City == 'Melbourne'", "value": 28},
            {"test": "datum.City == 'Canberra'", "value": 14},
            {"test": "datum.City == 'Sydney'", "value": -12}
          ],
          "value": 0
        }
      }
    },
    {
      "data": {
        "url": "data/cpi_australia_capital_city.csv"
      },
      "transform": [
        {"filter": "datum.Date == selected_date"},
        {
          "calculate": "datum.City == 'Horbart' ? 'Hobart' : datum.City",
          "as": "Clean_City"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "fill": "#181d20",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "text": {"field": "Clean_City", "type": "nominal"},
        "align": {
          "condition": [
            {"test": "datum.City == 'Canberra'", "value": "right"},
            {"test": "datum.City == 'Sydney'", "value": "left"},
            {"test": "datum.City == 'Melbourne'", "value": "center"},
            {"test": "datum.City == 'Hobart' || datum.City == 'Horbart'", "value": "left"},
            {"test": "datum.City == 'Perth'", "value": "right"},
            {"test": "datum.City == 'Brisbane'", "value": "left"},
            {"test": "datum.City == 'Adelaide'", "value": "right"},
            {"test": "datum.City == 'Darwin'", "value": "center"}
          ],
          "value": "center"
        },
        "dx": {
          "condition": [
            {"test": "datum.City == 'Canberra'", "value": -26},
            {"test": "datum.City == 'Sydney'", "value": 26},
            {"test": "datum.City == 'Hobart' || datum.City == 'Horbart'", "value": 26},
            {"test": "datum.City == 'Perth'", "value": -26},
            {"test": "datum.City == 'Brisbane'", "value": 26},
            {"test": "datum.City == 'Adelaide'", "value": -26}
          ],
          "value": 0
        },
        "dy": {
          "condition": [
            {"test": "datum.City == 'Darwin'", "value": -24},
            {"test": "datum.City == 'Melbourne'", "value": 28},
            {"test": "datum.City == 'Canberra'", "value": 14},
            {"test": "datum.City == 'Sydney'", "value": -12}
          ],
          "value": 0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Date": "2026-07",
            "Lon": 147.3272,
            "Lat": -42.8821,
            "label": [
              "2026 Peak:",
              "Hobart (4.5%)"
            ]
          }
        ]
      },
      "transform": [
        {"filter": "datum.Date == selected_date"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 30,
        "dy": -2,
        "fontSize": 13,
        "fontWeight": "bold",
        "lineHeight": 16,
        "fill": "#b45309"
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {
            "Date": "2025-07",
            "Lon": 153.0251,
            "Lat": -27.4698,
            "label": [
              "2025 Peak:",
              "Brisbane (4.8%)"
            ]
          }
        ]
      },
      "transform": [
        {"filter": "datum.Date == selected_date"}
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -30,
        "dy": -18,
        "fontSize": 13,
        "fontWeight": "bold",
        "lineHeight": 16,
        "fill": "#b45309"
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}