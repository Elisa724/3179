{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "transparent",
  "data": {
    "url": "data/connected_macro_trajectory.csv"
  },
  "transform": [
    {
      "calculate": "round((datum.WPI_Growth - datum.CPI_Inflation) * 100) / 100",
      "as": "Real_Wage_Gap"
    },
    {
      "calculate": "round((datum.Cash_Rate - datum.CPI_Inflation) * 100) / 100",
      "as": "Real_Cash_Rate"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#dcd7c9",
        "strokeWidth": 1.5,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "x": {"datum": 0}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#dcd7c9",
        "strokeWidth": 1.5,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "y": {"datum": 0}
      }
    },
    {
      "mark": {
        "type": "text",
        "text": "← Living Standards Squeeze (WPI < CPI)  |  Real Pay Ahead (WPI > CPI) →",
        "font": "Inter, sans-serif",
        "fontSize": 9.5,
        "fontStyle": "italic",
        "fontWeight": 500,
        "color": "#8c7b4d",
        "x": 8,
        "y": 14,
        "align": "left",
        "baseline": "top"
      },
      "data": {"values": [{}]}
    },
    {
      "mark": {
        "type": "line",
        "color": "#1b382b",
        "strokeWidth": 2.4,
        "opacity": 0.55,
        "interpolate": "cardinal",
        "tension": 0.65
      },
      "encoding": {
        "x": {"field": "Real_Wage_Gap", "type": "quantitative"},
        "y": {"field": "Real_Cash_Rate", "type": "quantitative"},
        "order": {"field": "Date", "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 190,
        "stroke": "#1b382b",
        "strokeWidth": 1.6,
        "opacity": 0.95
      },
      "encoding": {
        "x": {
          "field": "Real_Wage_Gap",
          "type": "quantitative",
          "title": "Real Wage Growth Gap (% WPI − CPI)",
          "scale": {"domain": [-4.8, 2.2]},
          "axis": {
            "titleFont": "Inter, sans-serif",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "titleColor": "#1b382b",
            "labelFont": "Inter, sans-serif",
            "labelFontSize": 10,
            "labelColor": "#5e6b64",
            "gridColor": "#e4dfd3",
            "gridDash": [3, 3],
            "tickColor": "#bcb382",
            "domainColor": "#bcb382"
          }
        },
        "y": {
          "field": "Real_Cash_Rate",
          "type": "quantitative",
          "title": "Real Cash Rate (% Cash Rate − CPI) [← Stimulatory | Restrictive ↑]",
          "scale": {"domain": [-6.0, 2.6]},
          "axis": {
            "titleFont": "Inter, sans-serif",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "titleColor": "#1b382b",
            "labelFont": "Inter, sans-serif",
            "labelFontSize": 10,
            "labelColor": "#5e6b64",
            "gridColor": "#e4dfd3",
            "gridDash": [3, 3],
            "tickColor": "#bcb382",
            "domainColor": "#bcb382"
          }
        },
        "color": {
          "field": "CPI_Inflation",
          "type": "quantitative",
          "title": "Headline CPI Inflation (%)",
          "scale": {
            "type": "linear",
            "range": ["#edd8ab", "#d9822b", "#b84319", "#6e1a0b"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 240,
            "gradientThickness": 9,
            "titleFont": "Inter, sans-serif",
            "titleFontSize": 10.5,
            "titleFontWeight": 600,
            "titleColor": "#1b382b",
            "labelFont": "Inter, sans-serif",
            "labelFontSize": 9.5,
            "labelColor": "#5e6b64"
          }
        },
        "tooltip": [
          {"field": "Quarter_Label", "type": "nominal", "title": "Milestone Quarter"},
          {"field": "Real_Wage_Gap", "type": "quantitative", "title": "Real Wage Gap (WPI − CPI %)", "format": "+.1f"},
          {"field": "Real_Cash_Rate", "type": "quantitative", "title": "Real Cash Rate (Rate − CPI %)", "format": "+.2f"},
          {"field": "WPI_Growth", "type": "quantitative", "title": "Nominal Wage Growth (WPI %)", "format": ".1f"},
          {"field": "Cash_Rate", "type": "quantitative", "title": "Nominal Cash Rate (%)", "format": ".2f"},
          {"field": "CPI_Inflation", "type": "quantitative", "title": "Headline CPI Inflation (%)", "format": ".1f"},
          {"field": "RBA_Decision_Date", "type": "nominal", "title": "Governing Decision"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.Quarter_Label == 'Jun-23' || datum.Quarter_Label == 'Jun-25' || datum.Quarter_Label == 'Jun-26'"}
      ],
      "mark": {
        "type": "text",
        "font": "Inter, sans-serif",
        "fontSize": 10.5,
        "fontWeight": 700,
        "color": "#1b382b",
        "baseline": "bottom",
        "dy": -10,
        "stroke": "#ffffff",
        "strokeWidth": 2.5,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {"field": "Real_Wage_Gap", "type": "quantitative"},
        "y": {"field": "Real_Cash_Rate", "type": "quantitative"},
        "text": {"field": "Quarter_Label", "type": "nominal"}
      }
    },
    {
      "transform": [
        {"filter": "datum.Quarter_Label == 'Jun-23' || datum.Quarter_Label == 'Jun-25' || datum.Quarter_Label == 'Jun-26'"}
      ],
      "mark": {
        "type": "text",
        "font": "Inter, sans-serif",
        "fontSize": 10.5,
        "fontWeight": 700,
        "color": "#1b382b",
        "baseline": "bottom",
        "dy": -10
      },
      "encoding": {
        "x": {"field": "Real_Wage_Gap", "type": "quantitative"},
        "y": {"field": "Real_Cash_Rate", "type": "quantitative"},
        "text": {"field": "Quarter_Label", "type": "nominal"}
      }
    },
    {
      "transform": [
        {"filter": "datum.Quarter_Label == 'Jun-21' || datum.Quarter_Label == 'Jun-22' || datum.Quarter_Label == 'Jun-24'"}
      ],
      "mark": {
        "type": "text",
        "font": "Inter, sans-serif",
        "fontSize": 10.5,
        "fontWeight": 700,
        "color": "#1b382b",
        "baseline": "top",
        "dy": 10,
        "stroke": "#ffffff",
        "strokeWidth": 2.5,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {"field": "Real_Wage_Gap", "type": "quantitative"},
        "y": {"field": "Real_Cash_Rate", "type": "quantitative"},
        "text": {"field": "Quarter_Label", "type": "nominal"}
      }
    },
    {
      "transform": [
        {"filter": "datum.Quarter_Label == 'Jun-21' || datum.Quarter_Label == 'Jun-22' || datum.Quarter_Label == 'Jun-24'"}
      ],
      "mark": {
        "type": "text",
        "font": "Inter, sans-serif",
        "fontSize": 10.5,
        "fontWeight": 700,
        "color": "#1b382b",
        "baseline": "top",
        "dy": 10
      },
      "encoding": {
        "x": {"field": "Real_Wage_Gap", "type": "quantitative"},
        "y": {"field": "Real_Cash_Rate", "type": "quantitative"},
        "text": {"field": "Quarter_Label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Inter, sans-serif"
  }
}