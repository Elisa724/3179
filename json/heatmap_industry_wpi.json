{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 490,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/heatmap_industry_wpi.csv"
  },
  "transform": [
    {
      "calculate": "datum.WPI_Growth != null ? datum.WPI_Growth : (datum.Wage_Growth != null ? datum.Wage_Growth : (datum.Value != null ? datum.Value : (datum.WPI != null ? datum.WPI : (datum.Percentage_Change != null ? datum.Percentage_Change : datum.Real_Wage_Gap))))",
      "as": "Wage_Value"
    },
    {
      "calculate": "datum.Short_Name != null ? datum.Short_Name : datum.Industry",
      "as": "Display_Industry"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "June Quarter",
          "scale": {
            "paddingInner": 0.04,
            "paddingOuter": 0
          },
          "axis": {
            "labelFont": "Inter, sans-serif",
            "labelFontSize": 11,
            "labelFontWeight": 600,
            "titleFont": "Inter, sans-serif",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titleColor": "#1b382b",
            "titlePadding": 8,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Display_Industry",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Wage_Value",
            "op": "mean",
            "order": "descending"
          },
          "scale": {
            "paddingInner": 0.08,
            "paddingOuter": 0
          },
          "axis": {
            "labelFont": "Inter, sans-serif",
            "labelFontSize": 11,
            "labelColor": "#181d20",
            "ticks": false,
            "domain": false,
            "labelPadding": 6
          }
        },
        "color": {
          "field": "Wage_Value",
          "type": "quantitative",
          "title": "Annual Wage Growth (%)",
          "scale": {
            "type": "linear",
            "domain": [1.0, 3.5, 6.2],
            "range": ["#edf6f1", "#09814a", "#1b382b"]
          },
          "legend": {
            "direction": "horizontal",
            "orient": "bottom",
            "gradientLength": 240,
            "titleFont": "Inter, sans-serif",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "titleColor": "#1b382b",
            "labelFont": "Inter, sans-serif",
            "labelFontSize": 10,
            "offset": 10
          }
        },
        "tooltip": [
          {"field": "Industry", "type": "nominal", "title": "Industry Division"},
          {"field": "Year", "type": "ordinal", "title": "June Quarter"},
          {"field": "Wage_Value", "type": "quantitative", "title": "Annual Wage Growth (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter, sans-serif",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {
          "field": "Display_Industry",
          "type": "nominal",
          "sort": {
            "field": "Wage_Value",
            "op": "mean",
            "order": "descending"
          }
        },
        "text": {
          "field": "Wage_Value",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.Wage_Value >= 3.8",
            "value": "#ffffff"
          },
          "value": "#181d20"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "axis": {
      "domainColor": "#dcd7c9",
      "tickColor": "#dcd7c9",
      "grid": false
    }
  }
}